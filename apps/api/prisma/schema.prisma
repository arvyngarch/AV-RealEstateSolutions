generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParticipantRole { BUYER SELLER ADMIN }
enum VerificationStatus { UNVERIFIED PENDING APPROVED DECLINED }
enum ListingStatus { DRAFT ACTIVE REMOVED }
enum OfferStatus { SUBMITTED COUNTERED ACCEPTED REJECTED EXPIRED WITHDRAWN }
enum MilestoneStatus { PENDING IN_PROGRESS COMPLETE BLOCKED }
enum AgreementStatus { QUESTIONNAIRE GENERATED AWAITING_APPROVAL AWAITING_SIGNATURE SIGNED }
enum RepairRequestStatus { OPEN RESPONDED }

model Account {
  id                 String             @id @default(cuid())
  auth0Subject       String             @unique
  email              String             @unique
  role               ParticipantRole
  emailVerified      Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  profile            Profile?
  listings           Listing[]          @relation("SellerListings")
  buyerOffers        Offer[]            @relation("BuyerOffers")
  favorites          SavedFavorite[]
  buyerTransactions  Transaction[]      @relation("BuyerTransactions")
  sellerTransactions Transaction[]      @relation("SellerTransactions")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Profile {
  id        String   @id @default(cuid())
  accountId String   @unique
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model IdentitySubmission {
  id        String             @id @default(cuid())
  accountId String
  fileName  String
  status    VerificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String
  address     String
  bedrooms    Int
  bathrooms   Float
  squareFeet  Int
  askingPrice Decimal       @db.Decimal(12, 2)
  description String
  status      ListingStatus @default(DRAFT)
  seller      Account       @relation("SellerListings", fields: [sellerId], references: [id])
  photos      ListingPhoto[]
  offers      Offer[]
  favorites   SavedFavorite[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  fileName  String
  mimeType  String
  storageKey String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SavedFavorite {
  id        String   @id @default(cuid())
  buyerId   String
  listingId String
  buyer     Account  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([buyerId, listingId])
}

model Offer {
  id          String      @id @default(cuid())
  listingId   String
  buyerId     String
  terms       Json
  expiresAt   DateTime
  status      OfferStatus @default(SUBMITTED)
  history     NegotiationEvent[]
  transaction Transaction?
  listing     Listing     @relation(fields: [listingId], references: [id])
  buyer       Account     @relation("BuyerOffers", fields: [buyerId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model NegotiationEvent {
  id        String   @id @default(cuid())
  offerId   String
  actorId   String
  action    String
  detail    Json?
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Transaction {
  id          String      @id @default(cuid())
  offerId     String      @unique
  listingId   String
  buyerId     String
  sellerId    String
  closingDate DateTime?
  offer       Offer       @relation(fields: [offerId], references: [id])
  buyer       Account     @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller      Account     @relation("SellerTransactions", fields: [sellerId], references: [id])
  milestones  Milestone[]
  agreement   PurchaseAgreement?
  inspection  InspectionRequest?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Milestone {
  id        String          @id @default(cuid())
  transactionId String
  name      String
  status    MilestoneStatus @default(PENDING)
  nextAction String?
  blockedBy String?
  transaction Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  updatedAt DateTime        @updatedAt
  @@unique([transactionId, name])
}

model PurchaseAgreement {
  id                 String          @id @default(cuid())
  transactionId      String          @unique
  questionnaire      Json?
  templateName       String?
  content            String?
  status             AgreementStatus @default(QUESTIONNAIRE)
  legalReviewRequired Boolean        @default(true)
  buyerApproved      Boolean         @default(false)
  sellerApproved     Boolean         @default(false)
  signatureEnvelopeId String?        @unique
  transaction        Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model InspectionRequest {
  id              String   @id @default(cuid())
  transactionId   String   @unique
  companyName     String?
  appointmentAt   DateTime?
  reportFileName  String?
  reportMimeType  String?
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  repairRequests  RepairRequest[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RepairRequest {
  id          String              @id @default(cuid())
  inspectionId String
  finding     String
  requestedAction String
  sellerResponse String?
  status      RepairRequestStatus @default(OPEN)
  inspection  InspectionRequest   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}
