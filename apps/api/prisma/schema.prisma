generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParticipantRole {
  BUYER
  SELLER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  DECLINED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  REMOVED
}

enum OfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

enum AgreementStatus {
  QUESTIONNAIRE
  AWAITING_APPROVAL
  AWAITING_SIGNATURE
  SIGNED
}

enum RepairRequestStatus {
  OPEN
  RESPONDED
  ACCEPTED
  REJECTED
  COUNTERED
}

model Account {
  id                   String             @id @default(uuid())
  auth0Subject         String             @unique
  email                String             @unique
  emailVerified        Boolean            @default(false)
  role                 ParticipantRole
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  profile              Profile?
  identitySubmissions  IdentitySubmission[]
  listings             Listing[]          @relation("SellerListings")
  favorites            SavedFavorite[]
  offers               Offer[]            @relation("BuyerOffers")
  negotiationEvents    OfferEvent[]
  buyerTransactions    Transaction[]      @relation("BuyerTransactions")
  sellerTransactions   Transaction[]      @relation("SellerTransactions")
}

model Profile {
  id        String   @id @default(uuid())
  accountId String   @unique
  firstName String
  lastName  String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model IdentitySubmission {
  id        String             @id @default(uuid())
  accountId String
  fileName  String
  status    VerificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  account   Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Listing {
  id          String        @id @default(uuid())
  sellerId    String
  address     String
  bedrooms    Int
  bathrooms   Float
  squareFeet  Int
  askingPrice Decimal       @db.Decimal(14, 2)
  description String
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  seller      Account       @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  photos      ListingPhoto[]
  favorites   SavedFavorite[]
  offers      Offer[]
  transactions Transaction[]
}

model ListingPhoto {
  id         String   @id @default(uuid())
  listingId  String
  fileName   String
  mimeType   String
  storageKey String
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model SavedFavorite {
  id        String   @id @default(uuid())
  buyerId   String
  listingId String
  createdAt DateTime @default(now())
  buyer     Account  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([buyerId, listingId])
}

model Offer {
  id        String      @id @default(uuid())
  listingId String
  buyerId   String
  terms     Json
  status    OfferStatus @default(SUBMITTED)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     Account     @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  history   OfferEvent[]
  transaction Transaction?
}

model OfferEvent {
  id        String      @id @default(uuid())
  offerId   String
  actorId   String
  status    OfferStatus
  terms     Json?
  createdAt DateTime    @default(now())
  offer     Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  actor     Account     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

model Transaction {
  id             String            @id @default(uuid())
  offerId        String            @unique
  listingId      String?
  buyerId        String
  sellerId       String
  closingDate    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  offer          Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  listing        Listing?          @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer          Account           @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         Account           @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Restrict)
  milestones     TransactionMilestone[]
  agreement      PurchaseAgreement?
  inspection     InspectionRequest?
  repairRequests RepairRequest[]
}

model TransactionMilestone {
  id             String          @id @default(uuid())
  transactionId  String
  name           String
  status         MilestoneStatus @default(PENDING)
  actionRequired String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transaction    Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, name])
}

model PurchaseAgreement {
  id                  String          @id @default(uuid())
  transactionId       String          @unique
  questionnaire       Json?
  templateName        String?
  content             String?
  status              AgreementStatus @default(QUESTIONNAIRE)
  buyerApproved       Boolean         @default(false)
  sellerApproved      Boolean         @default(false)
  signatureEnvelopeId String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  transaction         Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model InspectionRequest {
  id             String          @id @default(uuid())
  transactionId  String          @unique
  appointmentAt  DateTime?
  reportFileName String?
  reportMimeType String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transaction    Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  repairRequests RepairRequest[]
}

model RepairRequest {
  id             String              @id @default(uuid())
  transactionId  String
  inspectionId   String?
  description    String
  proposedTerms  Json?
  sellerResponse String?
  counterTerms   Json?
  status         RepairRequestStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transaction    Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  inspection     InspectionRequest?  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}
